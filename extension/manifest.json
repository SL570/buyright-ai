{
  "manifest_version": 3,
  "name": "BuyRight AI",
  "version": "1.1.0",
  "description": "AI shopping advisor — get a buy / wait / negotiate verdict on any product page in seconds.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.bestbuy.com/*",
    "https://*.walmart.com/*",
    "https://*.target.com/*",
    "https://*.costco.com/*",
    "https://*.newegg.com/*",
    "https://*.sephora.com/*",
    "https://*.ulta.com/*",
    "https://*.nordstrom.com/*",
    "https://*.macys.com/*",
    "https://*.fragrancenet.com/*",
    "https://*.jomashop.com/*",
    "https://buyright-ai.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/dp/*",
        "https://*.amazon.com/gp/product/*",
        "https://*.bestbuy.com/site/*",
        "https://*.walmart.com/ip/*",
        "https://*.target.com/p/*",
        "https://*.costco.com/*/product.*",
        "https://*.newegg.com/p/*",
        "https://*.newegg.com/*/p/*",
        "https://*.sephora.com/product/*",
        "https://*.ulta.com/p/*",
        "https://*.nordstrom.com/s/*",
        "https://www.macys.com/shop/product/*",
        "https://*.fragrancenet.com/perfume/*",
        "https://*.fragrancenet.com/cologne/*",
        "https://*.jomashop.com/*/product/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BuyRight AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
